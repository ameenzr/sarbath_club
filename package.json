    "deploy:preview": "npm run build && node scripts/deploy-preview.js"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "qrcode": "^1.5.4" },
  "devDependencies": { "vite": "^7.0.0", "@vitejs/plugin-react": "^5.0.0", "wrangler": "^4.0.0", "typescript": "^5.9.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@playwright/test": "^1.55.0", "miniflare": "^4.20260730.0" },
  "overrides": { "undici": "^7.29.0", "sharp": "^0.35.4" }
